{
	"name": "@tironian/app",
	"private": true,
	"version": "7.11.1",
	"description": "Tironian: dictation you own. Local-first speech-to-text on macOS and Windows.",
	"exports": {
		"./app": "./src/lib/app/app.ts",
		"./commands": "./src/lib/commands.ts",
		"./workspace": "./src/lib/workspace/index.ts"
	},
	"imports": {
		"#platform/commands": "./src/lib/commands.tauri.ts",
		"#platform/analytics": "./src/lib/services/analytics/index.tauri.ts",
		"#platform/blobs": {
			"tironian-host": "./src/lib/services/blobs/index.tironian-host.ts",
			"default": "./src/lib/services/blobs/index.browser.ts"
		},
		"#platform/download": "./src/lib/services/download/index.tauri.ts",
		"#platform/http": "./src/lib/services/http/index.tauri.ts",
		"#platform/os": "./src/lib/platform/os.tauri.ts",
		"#platform/system-shortcuts": "./src/lib/platform/system-shortcuts.tauri.ts",
		"#platform/recorder": "./src/lib/services/recorder/index.tauri.ts",
		"#platform/recording-mic-level": "./src/lib/recording-overlay/mic-level.tauri.ts",
		"#platform/dictation-indicator": "./src/lib/dictation-indicator/DictationIndicator.tauri.svelte",
		"#platform/text": "./src/lib/services/text/index.tauri.ts",
		"#platform/context": "./src/lib/services/context/index.tauri.ts",
		"#platform/manual-recorder-config": "./src/lib/state/manual-recorder-config.tauri.ts",
		"#platform/tauri": "./src/lib/tauri.tauri.ts",
		"#platform/os-notify": "./src/lib/report/os-notify.tauri.ts",
		"#platform/base-path": {
			"tironian-host": "./src/lib/platform/base-path.tironian-host.ts",
			"default": "./src/lib/platform/base-path.browser.ts"
		},
		"#platform/window-events": "./src/lib/window-events.tauri.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"test": "bun test",
		"build": "NODE_ENV=production vite build",
		"build:tironian-host": "TIRONIAN_HOST=1 bun run build",
		"check": "bun run typecheck",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typecheck": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && svelte-check --tsconfig ./tsconfig.desktop.json",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"typecheck:desktop": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.desktop.json",
		"typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@tironian/ui": "workspace:*",
		"@tironian/vite-config": "workspace:*",
		"@inlang/paraglide-js": "^2.25.0",
		"@lucide/svelte": "catalog:",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/typography": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@types/bun": "catalog:",
		"@types/js-yaml": "^4.0.9",
		"fake-indexeddb": "^6.2.5",
		"mode-watcher": "catalog:",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-devtools-json": "^1.0.0",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"type": "module",
	"dependencies": {
		"@aptabase/web": "^0.4.3",
		"@fontsource-variable/instrument-sans": "^5.2.6",
		"@fontsource/ibm-plex-mono": "^5.2.6",
		"@tironian/blobs": "workspace:*",
		"@tironian/client": "workspace:*",
		"@tironian/constants": "workspace:*",
		"@tironian/data": "workspace:*",
		"@tironian/field": "workspace:*",
		"@tironian/recorder": "workspace:*",
		"@tironian/svelte": "workspace:*",
		"@mistralai/mistralai": "^1.9.18",
		"@sqlite.org/sqlite-wasm": "catalog:",
		"@standard-schema/spec": "catalog:",
		"@tanstack/svelte-query": "catalog:",
		"@tanstack/svelte-table": "catalog:",
		"@tanstack/table-core": "9.0.0-alpha.10",
		"@tauri-apps/api": "catalog:",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.0",
		"@tauri-apps/plugin-deep-link": "catalog:",
		"@tauri-apps/plugin-dialog": "^2.3.2",
		"@tauri-apps/plugin-fs": "catalog:",
		"@tauri-apps/plugin-http": "^2.5.9",
		"@tauri-apps/plugin-notification": "^2.3.0",
		"@tauri-apps/plugin-opener": "catalog:",
		"@tauri-apps/plugin-os": "^2.3.0",
		"arkregex": "catalog:",
		"arktype": "catalog:",
		"audio-recorder-polyfill": "^0.4.1",
		"bits-ui": "catalog:",
		"date-fns": "catalog:",
		"dexie": "^4.0.11",
		"dompurify": "^3.4.10",
		"elevenlabs": "^1.59.0",
		"fflate": "catalog:",
		"idb": "^8.0.3",
		"js-yaml": "^4.1.1",
		"marked": "catalog:",
		"mime": "catalog:",
		"nanoid": "catalog:",
		"tailwind-variants": "catalog:",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	}
}
