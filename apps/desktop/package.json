{
	"name": "@tironian/desktop",
	"description": "One desktop application host serving trusted Tironian SPAs and local blob storage from Bun.",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"exports": {
		".": "./src/main.ts"
	},
	"scripts": {
		"dev": "bun run dev:desktop",
		"dev:desktop": "tauri dev --config src-tauri/tauri.dev.conf.json",
		"build": "bun run clean:dist && bun run build:home && bun run build:tironian",
		"build:home": "vite build",
		"build:sidecar": "bun run scripts/build-sidecar.ts",
		"build:tironian": "bun run --cwd ../tironian build:tironian-host",
		"clean:dist": "bun run scripts/clean-dist.ts",
		"build:desktop": "bun run build && bun run build:sidecar",
		"desktop:build": "tauri build",
		"test": "bun test",
		"tauri": "tauri",
		"typecheck": "bun run typecheck:home && bun run --cwd ../tironian typecheck",
		"typecheck:home": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@tironian/blobs": "workspace:*",
		"@tironian/constants": "workspace:*",
		"@tironian/data": "workspace:*",
		"@tironian/field": "workspace:*",
		"@tironian/ui": "workspace:*",
		"@tironian/app": "workspace:*",
		"@tauri-apps/api": "catalog:",
		"hono": "catalog:",
		"mime": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tauri-apps/cli": "catalog:",
		"@types/bun": "catalog:",
		"fake-indexeddb": "^6.2.5",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-singlefile": "catalog:"
	},
	"license": "AGPL-3.0-or-later"
}
