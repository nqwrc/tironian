{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "trusted-dictation-overlay-development",
	"description": "Development origin variant of the Dictation recording overlay capability: its status and action events, plus the window verbs one reposition session needs.",
	"local": false,
	"windows": ["recording-overlay"],
	"remote": {
		"urls": ["http://127.0.0.1:*"]
	},
	"permissions": [
		"core:event:allow-emit",
		"core:event:allow-listen",
		"core:window:allow-current-monitor",
		"core:window:allow-set-position",
		"core:window:allow-set-size",
		"log:default"
	]
}
