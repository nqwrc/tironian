{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "trusted-dictation-native-production",
	"description": "Grants only the production Dictation app window its recording, transcription, local model administration (ADR-0245), delivery, and supporting desktop authority.",
	"local": false,
	"windows": ["dictation"],
	"remote": {
		"urls": ["http://127.0.0.1:41730"]
	},
	"permissions": [
		"core:default",
		"core:event:allow-emit",
		"core:event:allow-listen",
		"core:window:allow-hide",
		"core:window:allow-show",
		"core:window:allow-close",
		"core:window:allow-set-focus",
		"core:window:allow-unminimize",
		"core:window:allow-set-size",
		"core:window:allow-set-position",
		"core:window:allow-set-ignore-cursor-events",
		"allow-write-text",
		"allow-simulate-enter-keystroke",
		"allow-simulate-copy-keystroke",
		"allow-simulate-backspaces",
		"allow-enumerate-recording-devices",
		"allow-start-recording",
		"allow-stop-recording",
		"allow-cancel-recording",
		"allow-current-recording",
		"allow-encode-recording-for-upload",
		"allow-transcribe-recording",
		"allow-prewarm-model",
		"allow-get-local-transcription-readiness",
		"allow-list-models",
		"allow-download-model",
		"allow-cancel-download",
		"allow-delete-model",
		"allow-get-active-model",
		"allow-set-active-model",
		"allow-get-unload-policy",
		"allow-set-unload-policy",
		"allow-open-accessibility-settings",
		"allow-request-accessibility-permission",
		"allow-get-microphone-permission",
		"allow-request-microphone-permission",
		"allow-pause-playback",
		"allow-resume-playback",
		"allow-set-auto-paste-enabled",
		"allow-get-dictation-capability",
		"allow-get-foreground-context",
		"allow-replace-global-shortcuts",
		"allow-is-autostart-enabled",
		"allow-set-autostart-enabled",
		"clipboard-manager:allow-read-text",
		"clipboard-manager:allow-write-text",
		"dialog:allow-open",
		"dialog:allow-save",
		"fs:allow-read-file",
		"fs:allow-write-file",
		"deep-link:default",
		"log:default",
		"notification:default",
		"opener:allow-default-urls",
		"opener:allow-open-url",
		"os:default"
	]
}
