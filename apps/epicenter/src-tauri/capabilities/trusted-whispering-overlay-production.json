{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "trusted-whispering-overlay-production",
	"description": "Allows the production Whispering recording overlay to exchange its status and action events, and to place itself during one reposition session.",
	"local": false,
	"windows": ["recording-overlay"],
	"remote": {
		"urls": ["http://127.0.0.1:41730"]
	},
	"permissions": [
		"core:event:allow-emit",
		"core:event:allow-listen",
		"core:window:allow-current-monitor",
		"core:window:allow-set-position",
		"core:window:allow-set-size",
		"log:default"
	]
}
