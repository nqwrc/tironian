{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Tironian",
	"version": "0.1.0",
	"identifier": "app.tironian",
	"build": {
		"beforeBuildCommand": "bun run build:desktop",
		"beforeDevCommand": {
			"script": "bun run build",
			"wait": true
		},
		"frontendDist": "frontend-placeholder"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [],
		"security": {
			"capabilities": [
				"home-model-administration-production",
				"home-launch-application-production",
				"trusted-app-windows-production",
				"trusted-whispering-native-production",
				"trusted-whispering-overlay-production"
			],
			"csp": "default-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "msi", "nsis"],
		"category": "Productivity",
		"publisher": "Nicola Pandolfi",
		"copyright": "Copyright © 2026 Nicola Pandolfi. Based on Epicenter (AGPL-3.0).",
		"shortDescription": "Dictation you own.",
		"externalBin": ["binaries/tironian-host"],
		"resources": {
			"../dist": "apps-dist",
			"recorder-state-icons/studio_microphone.png": "recorder-state-icons/studio_microphone.png",
			"recorder-state-icons/red_large_square.png": "recorder-state-icons/red_large_square.png"
		},
		"icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
		"macOS": {
			"entitlements": "entitlements.plist",
			"hardenedRuntime": true,
			"minimumSystemVersion": "10.15",
			"signingIdentity": "-"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["tironian"]
			}
		}
	}
}
