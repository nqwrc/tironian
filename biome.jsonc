{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"plugins": ["./scripts/biome/c-json-errors.grit"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"parser": {
			"cssModules": true,
			"tailwindDirectives": true
		}
	},
	"html": {
		"experimentalFullSupportEnabled": true,
		"formatter": { "enabled": true, "indentScriptAndStyle": true }
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!.conductor",
			"!**/.svelte-kit",
			"!**/.astro",
			"!**/.plasmo",
			"!**/node_modules",
			"!**/build",
			"!**/dist",
			"!package-lock.json",
			"!pnpm-lock.yaml",
			"!yarn.lock",
			// Generated by the skill installer, not hand-edited source.
			"!skills-lock.json",
			// Reverse-engineering artifacts: extracted third-party bundles and
			// captured assets, kept byte-exact so a citation into them stays
			// true. A checkout that has them keeps them out of git through
			// .git/info/exclude, which Biome does not read (useIgnoreFile only
			// covers .gitignore), so without this a repo-wide `format` rewrites
			// minified bundles that cannot be restored from source control.
			"!research",
			"!**/.gitignore",
			"!.DS_Store",
			"!**/*.md",
			// svelte-check owns .svelte files. Biome's HTML/Svelte parser
			// rejects valid Svelte 5 syntax (e.g. value-less `{:then}`),
			// and the rules it can apply to script blocks duplicate what
			// svelte-check already enforces via TypeScript.
			"!**/*.svelte"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"identifierOrder": "natural"
					}
				}
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"nursery": {
				"useSortedClasses": "warn"
			},
			"suspicious": {
				// packages/data exports a type named `DataView`, which is also
				// the name of a JS global. Every violation this rule finds in
				// tracked source is `import type { DataView }`, a binding in the
				// type namespace that cannot shadow the value global, and Biome
				// cannot tell the two namespaces apart. The rule takes no
				// options, so the choice is off or an overrides list that grows
				// every time another package imports a core type. Renaming the
				// type to satisfy a linter is the wrong direction: `DataView`
				// is the store's vocabulary.
				"noShadowRestrictedNames": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"overrides": [
		{
			// Biome can lint <script> blocks in .astro components but can't see
			// template usage, so imports and handlers used only in templates
			// appear unused. (.svelte files are excluded from Biome entirely;
			// svelte-check owns them.)
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					},
					"style": {
						"useImportType": "off",
						"noNonNullAssertion": "off"
					},
					"suspicious": {
						"noConfusingVoidType": "off",
						"noTemplateCurlyInString": "off",
						"useIterableCallbackReturn": "off",
						"noExplicitAny": "off"
					},
					"a11y": {
						// SVG icons in components don't always need <title>
						"noSvgWithoutTitle": "off",
						// Astro components often omit button type in templates
						"useButtonType": "off",
						// autofocus is intentional UX in dialogs and forms
						"noAutofocus": "off",
						// Audio recording playback doesn't have captions
						"useMediaCaption": "off"
					}
				}
			}
		},
		{
			// Vendored PostHog analytics snippet — minified code, not worth linting
			"includes": ["**/posthog.astro"],
			"linter": { "enabled": false }
		}
	]
}
